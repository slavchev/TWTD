1000 DEFINT A-Z
1010 OPEN "COM1:9600,N,8,1,CS0,DS0,CD0,LF" AS #1
1020 PRINT "Listening on COM1..."
1030 B$=""
1040 Q=0
1050 ON COM(1) GOSUB 2000
1060 COM(1) ON
1070 K$=INKEY$
1080 IF K$<>CHR$(27) AND Q=0 THEN GOTO 1070
1090 COM(1) OFF
1100 CLOSE #1
1110 PRINT "Done."
1120 END
2000 WHILE LOC(1)>0
2010 C$=INPUT$(1,#1)
2020 IF C$=CHR$(13) THEN GOSUB 3000
2030 IF C$<>CHR$(13) AND C$<>CHR$(10) THEN B$=B$+C$
2040 WEND
2050 RETURN
3000 L$=B$
3010 B$=""
3020 PRINT "RX: ";L$
3030 IF L$="QUIT" THEN PRINT #1,"BYE":Q=1:RETURN
3040 R$=""
3050 FOR I=LEN(L$) TO 1 STEP -1
3060 R$=R$+MID$(L$,I,1)
3070 NEXT I
3080 PRINT #1,R$
3090 PRINT "TX: ";R$
3100 RETURN
