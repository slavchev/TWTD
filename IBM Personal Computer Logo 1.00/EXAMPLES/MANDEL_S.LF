TO MANDEL
CS HT
MAKE "MAXITER 16
MAKE "XMIN -2
MAKE "XMAX 0.5
MAKE "YMIN -1.25
MAKE "YMAX 1.25
MAKE "XRANGE :XMAX - :XMIN
MAKE "YRANGE :YMAX - :YMIN
MAKE "WIDTH 320
MAKE "HEIGHT 200
MAKE "XSCALE :XRANGE / :WIDTH
MAKE "YSCALE :YRANGE / :HEIGHT
MAKE "SY -99
REPEAT :HEIGHT [MAKE "SX -159 SCANLINE MAKE "SY :SY + 1]
END

TO SCANLINE
REPEAT :WIDTH [PLOTPT MAKE "SX :SX + 1]
END

TO PLOTPT
(LOCAL "CX "CY "ZX "ZY "I "TX)
MAKE "CX :XMIN + (:SX + 159) * :XSCALE
MAKE "CY :YMIN + (:SY + 99) * :YSCALE
MAKE "ZX 0
MAKE "ZY 0
MAKE "I 0
ITERATE
IF :I < :MAXITER [SETPC 1 + REMAINDER :I 3 DOT (LIST :SX :SY)]
END

TO ITERATE
IF :I > :MAXITER - 1 [STOP]
IF (:ZX * :ZX + :ZY * :ZY) > 4 [STOP]
MAKE "TX :ZX * :ZX - :ZY * :ZY + :CX
MAKE "ZY 2 * :ZX * :ZY + :CY
MAKE "ZX :TX
MAKE "I :I + 1
ITERATE
END

MAKE "STARTUP [MANDEL]
