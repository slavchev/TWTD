TO HOUSE
FULLSCREEN
CS HT PU
GROUND
WALLS
ROOF
CHIMNEY
DOOR
PANE [-50 -42] 24
PANE [26 -42] 24
SUN
PU HOME HT
END

TO GROUND
PU SETPOS [-155 -70] PD SETPOS [155 -70]
PU
END

TO WALLS
PU SETPOS [-60 -70] SETH 0 PD
REPEAT 2 [FD 70 RT 90 FD 120 RT 90]
PU
END

TO ROOF
PU SETPOS [-70 0] PD
SETPOS [0 50]
SETPOS [70 0]
SETPOS [-70 0]
PU
END

TO CHIMNEY
PU SETPOS [32 27] PD
SETPOS [32 45]
SETPOS [46 45]
SETPOS [46 17]
PU
END

TO DOOR
PU SETPOS [-15 -70] SETH 0 PD
FD 45 RT 90 FD 30 RT 90 FD 45
DOT [9 -46]
PU
END

TO PANE :POS :SIZE
(LOCAL "X "Y "CX "CY "RGT "TOP)
MAKE "X FIRST :POS
MAKE "Y LAST :POS
MAKE "RGT :X + :SIZE
MAKE "TOP :Y + :SIZE
MAKE "CX :X + :SIZE / 2
MAKE "CY :Y + :SIZE / 2
PU SETPOS :POS SETH 0 PD
REPEAT 4 [FD :SIZE RT 90]
PU SETPOS LIST :CX :Y PD SETPOS LIST :CX :TOP
PU SETPOS LIST :X :CY PD SETPOS LIST :RGT :CY
PU
END

TO SUN
PU SETPOS [-138 70] SETH 0 PD
REPEAT 36 [FD 4 RT 10]
PU
END

MAKE "STARTUP [HOUSE]
