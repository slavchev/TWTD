TO CURVE.RT :PART :SIZE
REPEAT :PART * 24 [FD :SIZE RT 15]
END

TO CURVE.LT :PART :SIZE
REPEAT :PART * 24 [FD :SIZE LT 15]
END

TO POSY
REPEAT 6 [CURVE.RT 5/6 4 CURVE.LT 4/6 10 CURVE.LT 1/3 8]
END

TO LACE.EDGE
REPEAT 12 [CURVE.RT 0.3 3 CURVE.LT 0.5 5 CURVE.RT 0.3 10 CURVE.LT 0.5 5]
END

TO LACE
PU SETPOS SE XCOR + 33 YCOR - 58 PD
LACE.EDGE
PU SETPOS SE XCOR - 33 YCOR + 58 PD
END


