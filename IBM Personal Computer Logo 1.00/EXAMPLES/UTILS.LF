TO UTILS.BLOAD :NAME
LOCAL "RESERVED
MAKE "RESERVED UTILS.CMDLINE.READNUM
IF OR :RESERVED < 1 :RESERVED > 64 [PR [MISSING OR WRONG COMMAND LINE PARAMETER] THROW "TOPLEVEL]
MAKE "UTILS.BLOAD.SEG UTILS.MEM.TOP.SEG - (:RESERVED * 64)
.BLOAD :NAME :UTILS.BLOAD.SEG 0
END

TO UTILS.CALL :NAME
.CALL :UTILS.BLOAD.SEG UTILS.FIND.FUNCTION.OFFSET :NAME
END

TO UTILS.GET.CHARS :SEG :OFF :LEN
IF :LEN = 0 [OUTPUT "]
OUTPUT WORD CHAR .EXAMINE :SEG :OFF UTILS.GET.CHARS :SEG :OFF + 1 :LEN - 1
END

TO UTILS.PSP.SEG
.DEPOSIT 0 512 180
.DEPOSIT 0 513 81
.DEPOSIT 0 514 205
.DEPOSIT 0 515 33
.DEPOSIT 0 516 46
.DEPOSIT 0 517 137
.DEPOSIT 0 518 30
.DEPOSIT 0 519 10
.DEPOSIT 0 520 2
.DEPOSIT 0 521 203
.CALL 0 512
OUTPUT (.EXAMINE 0 523) * 256 + (.EXAMINE 0 522)
END

TO UTILS.CMDLINE
LOCAL "SEG
MAKE "SEG UTILS.PSP.SEG
OUTPUT UTILS.GET.CHARS :SEG 129 (.EXAMINE :SEG 128)
END

TO UTILS.CMDLINE.READNUM
LOCAL "SEG
MAKE "SEG UTILS.PSP.SEG
OUTPUT UTILS.READNUM :SEG 129 (.EXAMINE :SEG 128) 0
END

TO UTILS.READNUM :SEG :OFFSET :LEN :ACC
IF :LEN = 0 [OUTPUT :ACC]
LOCAL "B
MAKE "B .EXAMINE :SEG :OFFSET
IF AND :B > 47 :B < 58 [OUTPUT UTILS.READNUM :SEG (:OFFSET + 1) (:LEN - 1) ((:ACC * 10) + :B - 48)]
OUTPUT UTILS.READNUM :SEG (:OFFSET + 1) (:LEN - 1) :ACC
END

TO UTILS.MEM.TOP.SEG
OUTPUT ((.EXAMINE 64 20) * 256 + (.EXAMINE 64 19)) * 64
END

TO UTILS.READNAME :P
IF (.EXAMINE :UTILS.BLOAD.SEG :P) = 0 [OUTPUT "]
OUTPUT WORD (CHAR .EXAMINE :UTILS.BLOAD.SEG :P) UTILS.READNAME (:P + 1)
END

TO UTILS.FIND.FUNCTION.OFFSET :NAME
LOCAL "OFFSET
MAKE "OFFSET UTILS.SCAN.FUNCTION.OFFSET :NAME 0
IF :OFFSET < 0 [PR (SE [FUNCTION] :NAME [IS NOT IN EXPORT TABLE]) THROW "TOPLEVEL]
OUTPUT :OFFSET
END

TO UTILS.SCAN.FUNCTION.OFFSET :NAME :POS
IF (.EXAMINE :UTILS.BLOAD.SEG :POS) = 0 [OUTPUT -1]
LOCAL "ENTRY.NAME
LOCAL "VALUE.POS
MAKE "ENTRY.NAME UTILS.READNAME :POS
MAKE "VALUE.POS :POS + (COUNT :ENTRY.NAME) + 1
IF :ENTRY.NAME = :NAME [OUTPUT ((.EXAMINE :UTILS.BLOAD.SEG (:VALUE.POS + 1)) * 256) + (.EXAMINE :UTILS.BLOAD.SEG :VALUE.POS)]
OUTPUT UTILS.SCAN.FUNCTION.OFFSET :NAME (:VALUE.POS + 2)
END
